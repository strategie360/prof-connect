{
  "name": "prof-connect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"const fs=require('fs');['app/page.tsx','middleware.ts'].forEach(f=>{try{fs.unlinkSync(f)}catch{}});\" && next dev",
    "build": "node -e \"const fs=require('fs');['app/page.tsx','middleware.ts'].forEach(f=>{try{fs.unlinkSync(f)}catch{}});\" && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
